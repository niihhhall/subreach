# Reddit-outreach backend (read-only JSON API) + client token.
# On Vercel, set these in Project Settings -> Environment Variables.
# Locally, copy to .env and fill in, or use the in-app connection screen.

# Base URL of the reddit-outreach FastAPI app (no trailing slash).
VITE_API_BASE=https://your-outreach-app.herokuapp.com

# CLIENT_TOKEN configured on the backend (read-only client access).
VITE_CLIENT_TOKEN=set-me-to-the-backend-CLIENT_TOKEN

# Optional: pin a specific campaign by name. If empty, the backend default is used.
VITE_CAMPAIGN=
